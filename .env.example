# Settings for the root Python tools: the standalone API (`python -m api`), the measures and the
# data model loader. All are optional; the defaults run the Explorer on the bundled mock data.
# Export them in your shell, or copy this file to .env (git-ignored) and load it yourself.
# The Playground server and web app read their own files:
#   playground/server_application/.env.example
#   playground/client_application/.env.example

# Optional. The SQLite file `python -m api load` writes and the API and chat read.
# Default: normalized-data-model/output/pdp.sqlite
# UNCF_DATABASE=normalized-data-model/output/pdp.sqlite

# Optional. https links to a school's cohort and course files in private storage, for a hosted
# build that can't pass --cohort and --course. Secret: set them in the host, never here.
# UNCF_COHORT_URL=https://storage.example.edu/pdp/cohort.csv?token=...
# UNCF_COURSE_URL=https://storage.example.edu/pdp/course.csv?token=...

# Optional. The data source every answer names. Default: the synthetic sample's description.
# UNCF_SOURCE=Example College PDP files, fall 2026 release

# Optional. A school's own names for measures, from LOCAL_NAMES in measures/definitions.py.
# Values: fmu | benedict. Unset: the PDP's standard names.
# UNCF_SCHOOL=fmu

# Optional. Browser origins allowed to call the standalone API, comma-separated.
# Default: http://localhost:3000
# UNCF_CORS_ORIGINS=http://localhost:3000

# Optional. Which data coverage the chat analyses may assume. Default: analytics/config/analytics.yaml
# UNCF_ANALYTICS_CONFIG=analytics/config/analytics.yaml

# Optional. Seconds before a v2 analysis request stops. Default: 10
# UNCF_ANALYSIS_V2_TIMEOUT_SECONDS=10

# Optional. Only to load the data model into PostgreSQL instead of SQLite
# (python -m src.loader.load --backend postgres, from normalized-data-model/).
# PDP_POSTGRES_URL=postgresql://user:password@localhost:5432/pdp

# Optional, tests only. A throwaway PostgreSQL database for the parity tests; they skip without it.
# PDP_TEST_POSTGRES_URL=postgresql://pdp:pdp@localhost:5432/pdp
# Set to 1 to make a skipped PostgreSQL test fail (CI does this).
# PDP_REQUIRE_POSTGRES=1
