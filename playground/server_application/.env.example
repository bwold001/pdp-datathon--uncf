# Settings for the Playground server (app/core/config.py). All are optional for the Explorer pages.
# Copy to .env.development.local (git-ignored) to use them. Never put a real key in a committed file.
# Load order, later wins: .env.<APP_ENV> (committed defaults), .env.<APP_ENV>.local, real environment.
# The root settings in ../../.env.example (UNCF_DATA_LABEL, UNCF_SOURCE, UNCF_DATABASE and the rest) are
# read only from the real environment, not from these files. Export them before you start the server.

# Optional. development | staging | production. Default: development. Production hides /docs.
# APP_ENV=development

# Optional. The database the pages and chat read. Default: the SQLite file `python -m api load`
# builds, normalized-data-model/output/pdp.sqlite. A postgresql:// URL also works.
# DATABASE_URL=postgresql://user:password@localhost:5432/pdp

# Optional. Browser origins allowed to call the server, as a JSON list.
# CORS_ORIGINS=["http://localhost:3000"]

# Optional. Turns the chat routes on. Default: false, but .env.development sets it to true.
# UNCF_CHAT_ENABLED=false

# Required for chat only. Your own OpenRouter key (https://openrouter.ai). You pay for its use.
# OPENROUTER_API_KEY=your-openrouter-key

# Optional. A tool-capable OpenRouter model ID, written provider/model. Default: openai/gpt-4.1
# UNCF_CHAT_MODEL=openai/gpt-4.1
