# Local development. Committed: these are throwaway local credentials matching docker-compose.yml.
# Put personal overrides in .env.development.local (git-ignored).
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/playground_dev
DATABASE_ECHO=false
CORS_ORIGINS=["http://localhost:3000"]
# Student success chat (/chat). Put the real key in .env.development.local, never here.
# OPENROUTER_API_KEY=
# UNCF_CHAT_MODEL=openai/gpt-4.1
# Use a canonical OpenRouter model ID with tool support; legacy Claude names are not rewritten.

# Student success chat is independent of the Sandbox examples.
UNCF_CHAT_ENABLED=true
